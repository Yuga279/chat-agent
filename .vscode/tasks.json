{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build server",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "problemMatcher": "$tsc",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "graph:dev (inspect)",
            "type": "shell",
            "command": "node --inspect ./node_modules/.bin/langgraphjs dev --port 2024",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
