SYSTEM1_IDP_URL=https://localhost:5001
SYSTEM1_API_URL=https://localhost:5002
SYSTEM1_TENANT_ID=

SYSTEM1_MCP_CLIENT_ID=system1_mcp_client
SYSTEM1_MCP_CLIENT_SECRET=<value of IDPSettings:McpClientSecret>

# Public base URL this server is reachable at - must exactly match the redirect URI
# registered for this client in System1.IdentityProvider (Resources.cs GetClients()).
SYSTEM1_MCP_SERVER_URL=http://localhost:3100

PORT=3100

# 32-byte key (base64) used to encrypt linked users' refresh tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYSTEM1_TOKEN_STORE_KEY=<generated key>
SYSTEM1_TOKEN_STORE_PATH=./data/linked-accounts.db
