# System1 MCP server (see ../System1.MCP)
MCP_SERVER_URL=http://localhost:3100

# LangGraph agent's chat model provider: "openrouter" (default) or "gemini"
MODEL_PROVIDER=openrouter

# OpenRouter - used when MODEL_PROVIDER=openrouter
# openai/gpt-4o-mini is a small, cheap model - swap for anthropic/claude-sonnet-4.5 etc. for higher quality.
OPENROUTER_API_KEY=<your OpenRouter API key>
MODEL_NAME=openai/gpt-4o-mini

# Gemini - used when MODEL_PROVIDER=gemini
GEMINI_API_KEY=<your Gemini API key>
GEMINI_MODEL_NAME=gemini-flash-lite-latest

# Auth
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">

# MongoDB - stores users, conversations, and all agent memory
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=chat_agent

PORT=3200
