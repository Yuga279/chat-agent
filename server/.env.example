# System1 MCP server (see D:\Source6\System1.MCP)
MCP_SERVER_URL=http://localhost:3100

# Anthropic Claude - used as the LangGraph agent's chat model
ANTHROPIC_API_KEY=<your Anthropic API key>
MODEL_NAME=claude-sonnet-5

# Auth
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">
DB_PATH=./data/chat-agent.db

PORT=3200
