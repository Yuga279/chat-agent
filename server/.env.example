# System1 MCP server (see ../System1.MCP)
MCP_SERVER_URL=http://localhost:3100

# LangGraph agent's chat model provider: "openrouter" (default) or "gemini"
MODEL_PROVIDER=openrouter

# OpenRouter - used when MODEL_PROVIDER=openrouter
# openai/gpt-4o-mini is a small, cheap model - swap for anthropic/claude-sonnet-4.5 etc. for higher quality.
OPENROUTER_API_KEY=<your OpenRouter API key>
MODEL_NAME=openai/gpt-4o-mini

# Gemini - used when MODEL_PROVIDER=gemini
GEMINI_API_KEY=<your Gemini API key>
GEMINI_MODEL_NAME=gemini-flash-lite-latest

# Auth
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">

# MongoDB - stores users, conversations, and all agent memory
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=system1_chat_agent

PORT=3200

# LangSmith tracing (optional) - picked up automatically by LangChain/LangGraph on both :3200
# and :2024 (langgraph dev graphs, since langgraph.json points "env" at this same file).
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=<your LangSmith API key>
LANGCHAIN_PROJECT=chat-agent

# Langfuse tracing (optional) - enabled when both keys are set. Traces include the assistant
# turn, model generations, and tool calls, grouped by LangGraph thread/user.
LANGFUSE_PUBLIC_KEY=<your Langfuse public key>
LANGFUSE_SECRET_KEY=<your Langfuse secret key>
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=chat-agent@1.0.0
