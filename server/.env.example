# System1 MCP server (see ../System1.MCP)
MCP_SERVER_URL=http://localhost:3100

# OpenRouter - used as the LangGraph agent's chat model
OPENROUTER_API_KEY=<your OpenRouter API key>
MODEL_NAME=anthropic/claude-sonnet-4.5

# Auth
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">
DB_PATH=./data/chat-agent.db

PORT=3200
