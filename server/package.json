{
  "name": "system1-chat-agent",
  "version": "1.0.0",
  "description": "Web chat backend with a LangGraph agent that calls the System1 MCP server",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "graph:dev": "langgraphjs dev --port 2024",
    "verify:agui": "node --env-file=.env dist/scripts/verifyAgUiStream.js"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/langgraph": "^0.0.42",
    "@copilotkit/runtime": "^1.67.1",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-sdk": "^1.9.29",
    "@langchain/openai": "^1.5.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.5.5",
    "mongodb": "^6.10.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.4.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.5.3"
  }
}
